{
  "name": "exam-generator",
  "version": "0.8.1",
  "private": true,
  "description": "Экзамен+ — ИИ-ассистент для генерации и проверки экзаменационных заданий",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node tests/verify.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:llm": "node --env-file-if-exists=.env scripts/verify-provider.mjs"
  }
}
