# Server only. Set these in the hosting service's secret/environment settings.
# Ordinary practice works with all LLM fields empty.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PORT=8000
HOST=127.0.0.1
# Enable only when the page is embedded in the development environment preview.
EMBEDDED_PREVIEW=0

# Optional second model in the same site. Use its own ShareLLM key.
QWEN_API_KEY=
QWEN_BASE_URL=https://sharellm.net/v1
QWEN_MODEL=qwen3.8-flash
# GEMINI_API_KEY can be used instead of LLM_API_KEY for an explicit Gemini profile.
