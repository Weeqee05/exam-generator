# Скопируй в .env рядом с package.json. npm start прочитает файл автоматически.
# Для Gemini вставь ключ ниже. Без ключа работают тренировочные шаблоны.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PORT=8000
HOST=127.0.0.1
# Только для встроенного предпросмотра рабочей среды, на хостинге оставь 0.
EMBEDDED_PREVIEW=0

# Чтобы включить выбор Qwen, вставь отдельный ключ ShareLLM.
QWEN_API_KEY=
QWEN_BASE_URL=https://sharellm.net/v1
QWEN_MODEL=qwen3.8-27b
# GEMINI_API_KEY можно использовать вместо LLM_API_KEY для явного профиля Gemini.
